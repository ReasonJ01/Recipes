---
layout: layout.njk
pagination:
  data: collections.recipes
  size: 1
  alias: recipe
permalink: "/recipes/{{ recipe.data.title | slug }}/"
---

{% set sections = recipe.inputPath | parseRecipeSections %}
{% set groups = sections.Ingredients | ingredientGroups %}
{% set instructions = sections.Instructions | instructionsToList %}

<article class="recipe">
  <header class="recipe-header{% if recipe.data.image %} recipe-header--illustrated{% endif %}">
    <div class="recipe-header__text">
      {% if recipe.data.categories and recipe.data.categories.length %}
      <p class="recipe-categories">{{ recipe.data.categories | join(" · ") }}</p>
      {% endif %}
      <h1 class="recipe-title">{{ recipe.data.title }}</h1>
      {% if recipe.data.prep_time or recipe.data.cook_time or recipe.data.servings %}
      <dl class="recipe-meta">
        {% if recipe.data.prep_time %}<div><dt>Prep</dt><dd>{{ recipe.data.prep_time }}</dd></div>{% endif %}
        {% if recipe.data.cook_time %}<div><dt>Cook</dt><dd>{{ recipe.data.cook_time }}</dd></div>{% endif %}
        {% if recipe.data.servings %}<div><dt>Yield</dt><dd>{{ recipe.data.servings }}</dd></div>{% endif %}
      </dl>
      {% endif %}
      {% if recipe.data.source %}
      <p class="recipe-source">Adapted from {% if recipe.data.source_url %}<a href="{{ recipe.data.source_url }}" target="_blank" rel="noopener noreferrer">{{ recipe.data.source }}</a>{% else %}{{ recipe.data.source }}{% endif %}</p>
      {% endif %}
    </div>
    {% if recipe.data.image %}
    <figure class="recipe-image">
      <img src="/images/{{ recipe.data.image }}" alt="{{ recipe.data.title }}" width="800" height="800" fetchpriority="high">
    </figure>
    {% endif %}
  </header>

  <div class="recipe-body">
    <section class="recipe-section recipe-section--ingredients" aria-labelledby="ingredients-title">
      <h2 id="ingredients-title" class="recipe-section__title">Ingredients</h2>
      {% for group in groups %}
      <div class="ingredient-group">
        {% if group.title %}<h3 class="ingredient-group__title">{{ group.title }}</h3>{% endif %}
        <ul class="recipe-ingredients">
          {% for item in group.items %}<li><span class="recipe-ingredients__text">{{ item }}</span></li>{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>

    <div class="recipe-method">
      <section class="recipe-section recipe-section--instructions" aria-labelledby="method-title">
        <h2 id="method-title" class="recipe-section__title">Method</h2>
        <ol class="recipe-instructions">
          {% for item in instructions %}
          <li><span class="recipe-instructions__text">{{ item }}</span></li>
          {% endfor %}
        </ol>
      </section>
      {% if sections.Notes %}
      <aside class="recipe-notes" aria-labelledby="notes-title">
        <h2 id="notes-title" class="recipe-section__title">Kitchen notes</h2>
        {{ sections.Notes | markdown | safe }}
      </aside>
      {% endif %}
    </div>
  </div>
</article>
